# Keep source rasters out of Git; prepared JSON features and small GeoTIFFs
# remain shareable. Original PDS images can be several hundred megabytes.
backend/data/nasa_cache/*.IMG
backend/data/nasa_cache/*.img
backend/data/nasa_cache/*.aux.xml
backend/data/nasa_cache/DTEEC_034934_2155_034499_2155_A01.tif
backend/data/nasa_cache/*.tif
